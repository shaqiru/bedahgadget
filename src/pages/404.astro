---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404: Jalur Dokumen Terputus" noindex={true}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="iso-plate overflow-hidden">
      <div class="split-rule"></div>
      <div class="px-5 py-3 bg-elevated border-b border-line flex items-center justify-between font-mono text-xs tabular-nums">
        <span class="inline-flex items-center gap-2 font-bold text-accent-danger"><span class="status-dot" aria-hidden="true"></span>STATUS: HTTP 404 // OPEN CIRCUIT</span>
        <span class="text-ink-muted">NODE TIDAK DITEMUKAN</span>
      </div>
      <div class="p-6 sm:p-8 space-y-5">
        <h1 class="font-brand text-3xl sm:text-4xl text-ink">
          Jalur Halaman Tidak Ditemukan
        </h1>
        <p class="text-sm sm:text-base text-ink-secondary leading-relaxed max-w-xl">
          Alamat URL yang Anda tuju tidak mengarah ke dokumen aktif di dalam arsip
          <strong>bedahgadget.id</strong>. Silakan kembali ke indeks utama atau telusuri rubrik
          bedah perangkat keras di bawah ini.
        </p>
        <div class="flex flex-wrap items-center gap-3 pt-2 font-mono text-xs">
          <a
            href="/"
            class="btn btn-primary"
          >
            KEMBALI KE BERANDA
          </a>
          <a
            href="/bedah/"
            class="btn btn-secondary"
          >
            ARSIP BEDAH ANATOMI
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
