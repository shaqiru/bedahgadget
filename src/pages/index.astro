---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleList from '../components/ArticleList.astro';
import JsonLd from '../components/JsonLd.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import { getCollection } from 'astro:content';
import { articlePath } from '../lib/categories';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const canonicalURL = 'https://bedahgadget.id/';
const ogImage = 'https://bedahgadget.id/brand/png/lockup-horizontal-dark-1024.png';
const pageTitle = 'bedahgadget.id: Jurnalisme Teknis Bedah Hardware, AI Silikon & Review Laptop';
const pageDescription = 'Publikasi jurnalisme teknis independen yang membedah anatomi motherboard, silikon AI PC, dan mekanika laptop bersama workshop perbaikan FixNow.id Bandung.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  type="website"
  canonicalUrl={canonicalURL}
  image={ogImage}
>
  <Fragment slot="schema">
    <JsonLd
      type="website"
      title={pageTitle}
      description={pageDescription}
      url={canonicalURL}
      image={ogImage}
    />
    <JsonLd
      type="collection"
      title={pageTitle}
      description={pageDescription}
      url={canonicalURL}
      image={ogImage}
      items={articles.map((article) => ({
        name: article.data.title,
        url: articlePath(article.data.category, article.slug),
      }))}
    />
  </Fragment>

  <section id="hero" class="border-b border-line">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-10 lg:pt-20 lg:pb-14">
      <div class="max-w-[65ch] space-y-5">
        <h1 class="font-brand text-[2.25rem] leading-[1.05] tracking-tight text-ink sm:text-5xl lg:text-[3.5rem]">
          Bedah laptop sampai ke jalur dayanya.
        </h1>
        <p class="text-base leading-relaxed text-ink-secondary sm:text-lg">
          Kenapa laptop mati total, kepanasan, rusak kena air, atau engselnya patah. Setiap
          bahasan berangkat dari skema elektris dan kasus kerusakan di meja servis{' '}
          <a
            href="https://fixnow.id/?utm_source=bedahgadget&utm_medium=home_intro"
            target="_blank"
            rel="noopener"
            class="font-semibold text-accent-link underline underline-offset-4"
          >
            FixNow.id Bandung
          </a>.
        </p>
      </div>
    </div>
  </section>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <ArticleList
      articles={articles}
      heading="Semua artikel"
      headingId="feed-title"
      id="arsip"
      showCategory
      emptyMessage="Belum ada artikel. Silakan kembali lagi nanti."
    />
  </div>

  <FloatingCTA watch="#hero" />
</BaseLayout>
