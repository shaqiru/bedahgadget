---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import JsonLd from '../components/JsonLd.astro';
import AnatomyHero from '../components/AnatomyHero.astro';
import SymptomPanel from '../components/SymptomPanel.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import Icon from '../components/Icon.astro';
import Glyph from '../components/Glyph.astro';
import GlyphCapsule from '../components/GlyphCapsule.astro';
import type { GlyphName } from '../lib/glyphs';
import { getCollection } from 'astro:content';
import { articlePath, categories } from '../lib/categories';
import { laptopParts, symptoms, type ResolvedPart } from '../lib/laptop-parts';
import { readingTime } from '../lib/reading-time';

const allArticles = await getCollection('articles');
const sortedArticles = allArticles.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const bySlug = new Map(sortedArticles.map((a) => [a.slug, a]));
const find = (slug: string) => {
  const article = bySlug.get(slug);
  if (!article) throw new Error(`Artikel "${slug}" di src/lib/laptop-parts.ts tidak ditemukan.`);
  return article;
};

const parts: ResolvedPart[] = laptopParts.map((part) => {
  const article = find(part.slug);
  return {
    ...part,
    href: articlePath(article.data.category, article.slug),
    title: article.data.title,
    minutes: readingTime(article),
  };
});

const categoryKeys = Object.keys(categories) as (keyof typeof categories)[];
const categoryCounts = categoryKeys.map((key) => ({
  ...categories[key],
  count: sortedArticles.filter((a) => a.data.category === key).length,
}));

const rubricBlurb: Record<string, string> = {
  bedah: 'Cara kerja komponen sampai ke level sirkuit: VRM, pendingin, engsel, dan korosi.',
  ai: 'Arsitektur silikon untuk AI di laptop: NPU, GPU, dan jalur memorinya.',
  review: 'Checklist menilai jeroan laptop sebelum membeli, dari pendingin sampai kemudahan servis.',
};

const rubricGlyph: Record<string, GlyphName> = {
  bedah: 'screw-torx',
  ai: 'chip',
  review: 'fan',
};

const canonicalURL = 'https://bedahgadget.id/';
const ogImage = 'https://bedahgadget.id/brand/png/lockup-horizontal-dark-1024.png';
const pageTitle = 'bedahgadget.id: Jurnalisme Teknis Bedah Hardware, AI Silikon & Review Laptop';
const pageDescription = 'Publikasi jurnalisme teknis independen yang membedah anatomi motherboard, silikon AI PC, dan mekanika laptop bersama workshop perbaikan FixNow.id Bandung.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  type="website"
  canonicalUrl={canonicalURL}
  image={ogImage}
>
  <Fragment slot="schema">
    <JsonLd
      type="website"
      title={pageTitle}
      description={pageDescription}
      url={canonicalURL}
      image={ogImage}
    />
  </Fragment>

  <!-- HERO: figur laptop sebagai pintu masuk artikel -->
  <section id="hero" class="border-b border-line">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-10 lg:pt-20 lg:pb-14 space-y-10 lg:space-y-14">
      <div class="max-w-3xl mx-auto text-center space-y-6">
        <h1 class="font-brand text-[2.25rem] sm:text-5xl lg:text-[4rem] text-ink leading-[1.02] tracking-tight">
          Bedah laptop sampai ke jalur dayanya.
        </h1>
        <p class="text-base sm:text-lg text-ink-secondary leading-relaxed max-w-[56ch] mx-auto">
          Kenapa laptop mati total, kepanasan, rusak kena air, atau engselnya patah. Setiap
          bahasan berangkat dari skema elektris dan kasus kerusakan di meja servis{' '}
          <a
            href="https://fixnow.id/?utm_source=bedahgadget&utm_medium=hero_text"
            target="_blank"
            rel="noopener"
            class="text-accent-link font-semibold underline underline-offset-4"
          >
            FixNow.id Bandung
          </a>.
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <a
            href="https://fixnow.id/?utm_source=bedahgadget&utm_medium=hero_cta"
            target="_blank"
            rel="noopener"
            class="btn btn-primary"
          >
            Meja servis FixNow.id
          </a>
          <a href="#arsip" class="btn btn-secondary">Lihat semua artikel</a>
        </div>
      </div>

    </div>
    <!-- Figur selebar halaman (di luar container), sesuai permintaan pemilik. -->
    <AnatomyHero parts={parts} />
  </section>

  <!-- GEJALA -->
  <section aria-labelledby="gejala-title" class="py-12 lg:py-16 border-b border-line">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="gejala-title" class="font-brand text-2xl sm:text-3xl text-ink tracking-tight mb-8">
        Laptop kamu kenapa?
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {
          symptoms.map((symptom) => {
            const article = find(symptom.slug);
            return (
              <SymptomPanel
                label={symptom.label}
                href={articlePath(article.data.category, article.slug)}
                title={article.data.title}
                summary={article.data.description}
                topic={symptom.topic}
                slug={article.slug}
              />
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- RUBRIK -->
  <section aria-labelledby="rubrik-title" class="py-12 lg:py-16 border-b border-line">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="rubrik-title" class="font-brand text-2xl sm:text-3xl text-ink tracking-tight mb-8">
        Rubrik
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {
          categoryCounts.map((category) => (
            <a href={category.archivePath} class="panel group flex flex-col hover:border-line-strong transition-colors">
              <div class="panel-head">
                <span class="font-bold uppercase">{category.label}</span>
                <span class="text-ink-muted">{category.count} artikel</span>
              </div>
              <div class="p-5 space-y-4 flex-1 flex flex-col">
                <div class="flex items-start justify-between gap-4">
                  <p class="text-sm text-ink-secondary leading-relaxed">{rubricBlurb[category.key]}</p>
                  <Glyph name={rubricGlyph[category.key]} class="h-12 w-12 shrink-0" />
                </div>
                <div class="scale-rule mt-auto" aria-hidden="true" />
                <span class="font-mono text-xs font-bold uppercase text-accent-link underline underline-offset-4">
                  Buka arsip
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ARSIP dengan bar filter glass -->
  <section id="arsip" aria-labelledby="arsip-title" class="pb-12 lg:pb-16 border-b border-line scroll-mt-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 lg:pt-16">
      <h2 id="arsip-title" class="font-brand text-2xl sm:text-3xl text-ink tracking-tight">
        Arsip
      </h2>
    </div>

    <div class="glass glass-edge lg:sticky lg:top-16 z-30 border-y border-line mt-6">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex flex-col lg:flex-row lg:items-center gap-3">
        <div
          role="group"
          aria-label="Filter rubrik publikasi"
          class="flex flex-wrap items-center gap-2 font-mono text-xs tabular-nums"
        >
          <button
            type="button"
            aria-pressed="true"
            data-filter-category="all"
            class="rubrik-tab inline-flex min-h-11 items-center px-3.5 border border-line-strong bg-ink text-page font-bold"
          >
            SEMUA ({sortedArticles.length})
          </button>
          {
            categoryCounts.map((category) => (
              <button
                type="button"
                aria-pressed="false"
                data-filter-category={category.key}
                class="rubrik-tab inline-flex min-h-11 items-center px-3.5 border border-line-strong text-ink"
              >
                {category.label.toUpperCase()} ({category.count})
              </button>
            ))
          }
        </div>
        <div class="lg:ml-auto w-full lg:w-80">
          <label for="article-search" class="block mb-1 font-mono text-xs text-ink-secondary">Cari komponen atau gejala</label>
          <input
            id="article-search"
            type="search"
            placeholder="mis. VRM, engsel, NPU"
            class="w-full min-h-11 px-3.5 text-sm font-mono bg-surface text-ink border border-line-strong placeholder:text-ink-muted"
          />
        </div>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
      <p id="filter-status" class="sr-only" aria-live="polite" aria-atomic="true"></p>

      <div id="articles-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          sortedArticles.map((article) => (
            <div
              class="article-item"
              data-category={article.data.category}
              data-search={`${article.data.title} ${article.data.description} ${article.data.tags.join(' ')}`.toLowerCase()}
            >
              <ArticleCard article={article} />
            </div>
          ))
        }
      </div>

      <div id="empty-filter-state" class="hidden panel p-8 sm:p-10 text-center max-w-xl mx-auto my-8 space-y-4">
        <h3 class="font-brand text-xl text-ink">Belum ada artikel yang cocok</h3>
        <p class="text-sm text-ink-secondary">
          Coba istilah lain, misalnya VRM, pasta termal, engsel, korosi, RAM, atau NPU.
        </p>
        <button id="reset-filter-btn" type="button" class="btn btn-secondary">Tampilkan semua artikel</button>
      </div>
    </div>
  </section>

  <!-- WORKSHOP FixNow.id -->
  <section aria-labelledby="workshop-title" class="py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="panel overflow-hidden">
        <div class="split-rule" aria-hidden="true"></div>
        <div class="panel-head">
          <span class="font-bold">WORKSHOP MITRA // FIXNOW.ID BANDUNG</span>
          <span class="text-ink-muted">JL. MANTERON NO. 12, SUKALUYU, KOTA BANDUNG 40123</span>
        </div>

        <div class="p-6 sm:p-8 lg:p-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <div class="lg:col-span-6 space-y-4">
            <h2 id="workshop-title" class="font-brand text-2xl sm:text-3xl text-ink leading-snug">
              Apa yang dikerjakan di meja servis, dan apa yang tidak
            </h2>
            <p class="text-sm sm:text-base text-ink-secondary leading-relaxed max-w-[65ch]">
              Artikel di <strong>bedahgadget.id</strong> berangkat dari temuan fisik di meja kerja{' '}
              <a
                href="https://fixnow.id/?utm_source=bedahgadget&utm_medium=home_lab_section"
                target="_blank"
                rel="noopener"
                class="text-accent-link font-semibold underline underline-offset-4"
              >
                FixNow.id Bandung
              </a>. Batas pengerjaannya ditulis terbuka supaya kamu tahu sejak awal.
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
              <div class="p-4 bg-elevated border border-line space-y-2">
                <h3 class="flex items-center gap-2 font-mono text-xs font-bold uppercase text-accent-positive border-b border-line pb-1.5">
                  <Icon name="check" weight="bold" class="h-4 w-4 shrink-0" />
                  Bisa dikerjakan
                </h3>
                <ul class="text-sm text-ink-secondary space-y-1.5 list-disc pl-4">
                  <li>Perbaikan jalur daya motherboard (mikrosolder komponen SMD/MOSFET/IC PWM).</li>
                  <li>Pelacakan jalur komponen dengan skema boardview dan multimeter.</li>
                  <li>Penggantian keping memori VRAM pada jalur grafis laptop.</li>
                  <li>Konversi VGA diskrit ke grafis terintegrasi prosesor (Discrete-to-UMA).</li>
                </ul>
              </div>

              <div class="p-4 bg-elevated border border-line space-y-2">
                <h3 class="flex items-center gap-2 font-mono text-xs font-bold uppercase text-accent-danger border-b border-line pb-1.5">
                  <Icon name="x" weight="bold" class="h-4 w-4 shrink-0" />
                  Tidak dikerjakan
                </h3>
                <ul class="text-sm text-ink-secondary space-y-1.5 list-disc pl-4">
                  <li>Tidak melayani reballing chipset atau GPU utama karena tingkat kambuh tinggi.</li>
                  <li>Tidak melayani penggantian chip GPU utama atau penggunaan BGA Rework Station.</li>
                  <li>Khusus laptop (tidak melayani kartu VGA PC desktop).</li>
                  <li>Tidak menarik biaya pengecekan awal sebelum estimasi disetujui pelanggan.</li>
                </ul>
              </div>
            </div>
          </div>

          <div class="hidden lg:flex lg:col-span-1 justify-center">
            <GlyphCapsule
              id="capsule-workshop"
              glyphs={[['screw-phillips', 'heat'], ['choke', 'plate'], ['trace', 'ink'], ['capacitor', 'plate'], ['fan', 'accent']]}
              class="w-14"
            />
          </div>

          <div class="lg:col-span-5 bg-elevated border border-line p-5 sm:p-6 space-y-4">
            <dl class="space-y-3 text-sm text-ink-secondary">
              <div class="readout">
                <dt>Alamat</dt>
                <dd class="font-sans font-medium">
                  Jl. Manteron No. 12, Sukaluyu, Kec. Cibeunying Kaler, Kota Bandung, Jawa Barat 40123
                </dd>
              </div>
              <div class="readout">
                <dt>Jam operasional</dt>
                <dd class="font-normal text-ink-secondary space-y-0.5">
                  <div>Senin sampai Kamis: 09.00 sampai 17.00 WIB</div>
                  <div>Jumat: 13.00 sampai 16.00 WIB</div>
                  <div>Sabtu dan Minggu: 10.00 sampai 16.00 WIB</div>
                </dd>
              </div>
              <div class="readout">
                <dt>Estimasi pengerjaan</dt>
                <dd class="font-normal text-ink-secondary space-y-0.5">
                  <div>Servis ringan atau pembersihan termal: kurang dari 24 jam</div>
                  <div>Jalur motherboard atau konversi UMA: 3 sampai 7 hari kerja</div>
                </dd>
              </div>
              <div class="readout">
                <dt>Antar-jemput</dt>
                <dd class="font-normal text-ink-secondary">Gratis dalam radius 3 km dari workshop.</dd>
              </div>
            </dl>

            <div class="pt-3 border-t border-line flex flex-col gap-2.5">
              <a
                href="https://wa.me/6285139506080?text=Halo%20FixNow.id,%20saya%20membaca%20bedahgadget.id%20dan%20ingin%20jadwal%20cek%20gratis%20laptop%20saya."
                target="_blank"
                rel="noopener"
                class="btn btn-primary w-full"
              >
                WhatsApp 0851-3950-6080
              </a>
              <a
                href="https://fixnow.id/?utm_source=bedahgadget&utm_medium=home_cta"
                target="_blank"
                rel="noopener"
                class="btn btn-secondary w-full"
              >
                Kunjungi FixNow.id
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <FloatingCTA watch="#hero" />
</BaseLayout>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.rubrik-tab');
  const items = document.querySelectorAll<HTMLElement>('.article-item');
  const searchInput = document.getElementById('article-search') as HTMLInputElement | null;
  const emptyState = document.getElementById('empty-filter-state');
  const resetBtn = document.getElementById('reset-filter-btn');
  const filterStatus = document.getElementById('filter-status');

  let activeCategory = 'all';
  let searchQuery = '';

  function applyFilter() {
    let visibleCount = 0;
    items.forEach((item) => {
      const matchesCat = activeCategory === 'all' || item.dataset.category === activeCategory;
      const matchesSearch = !searchQuery || (item.dataset.search || '').includes(searchQuery);
      const visible = matchesCat && matchesSearch;
      item.classList.toggle('hidden', !visible);
      if (visible) visibleCount++;
    });
    emptyState?.classList.toggle('hidden', visibleCount > 0);
    if (filterStatus) {
      filterStatus.textContent =
        visibleCount === 1 ? '1 artikel ditampilkan.' : `${visibleCount} artikel ditampilkan.`;
    }
  }

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      activeCategory = button.dataset.filterCategory || 'all';
      filterButtons.forEach((other) => {
        const isActive = other === button;
        other.setAttribute('aria-pressed', String(isActive));
        other.classList.toggle('bg-ink', isActive);
        other.classList.toggle('text-page', isActive);
        other.classList.toggle('font-bold', isActive);
        other.classList.toggle('text-ink', !isActive);
      });
      applyFilter();
    });
  });

  searchInput?.addEventListener('input', () => {
    searchQuery = searchInput.value.trim().toLowerCase();
    applyFilter();
  });

  resetBtn?.addEventListener('click', () => {
    searchQuery = '';
    if (searchInput) searchInput.value = '';
    filterButtons[0]?.click();
  });
</script>
