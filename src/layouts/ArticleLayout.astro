---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import FixNowCallout from '../components/FixNowCallout.astro';
import ArticleList from '../components/ArticleList.astro';
import { articlePath, getCategory } from '../lib/categories';

export interface Props {
  article: CollectionEntry<'articles'>;
  related: CollectionEntry<'articles'>[];
}

const { article, related } = Astro.props;
const category = getCategory(article.data.category);
const { Content } = await article.render();

const wordCount = article.body ? article.body.trim().split(/\s+/).length : 750;
const readingTime = Math.max(4, Math.ceil(wordCount / 180));

const formattedDate = article.data.pubDate.toLocaleDateString('id-ID', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const siteUrl = 'https://bedahgadget.id';
const articleUrl = `${siteUrl}${articlePath(article.data.category, article.slug)}`;
const resolvedImage = article.data.image.src.startsWith('http')
  ? article.data.image.src
  : `${siteUrl}${article.data.image.src}`;

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: category.label, url: category.archivePath },
  { name: article.data.title, url: articlePath(article.data.category, article.slug) },
];

const showsServiceScore =
  category.ledgerShowsServiceScore && article.data.repairabilityScore !== undefined;
---

<BaseLayout
  title={article.data.title}
  description={article.data.description}
  image={resolvedImage}
  type={category.schemaType}
  publishDate={article.data.pubDate}
  updatedDate={article.data.updatedDate}
  author={article.data.author}
  canonicalUrl={articleUrl}
>
  <Fragment slot="schema">
    <JsonLd
      type={category.schemaType}
      title={article.data.title}
      description={article.data.description}
      url={articleUrl}
      image={resolvedImage}
      pubDate={article.data.pubDate}
      updatedDate={article.data.updatedDate}
      author={article.data.author}
      category={category.articleSection}
      breadcrumbs={breadcrumbs}
      faqs={article.data.faqs}
    />
  </Fragment>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <article class="py-12 lg:py-20">
      <!-- Breadcrumb Navigation -->
      <nav aria-label="Breadcrumb" class="breadcrumb mb-8 font-mono text-xs text-ink-muted">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="inline-flex min-h-11 items-center hover:text-accent-link">BERANDA</a></li>
          <li><a href={category.archivePath} class="inline-flex min-h-11 items-center hover:text-accent-link">{category.breadcrumbLabel}</a></li>
          <li>
            <a
              href={articlePath(article.data.category, article.slug)}
              aria-current="page"
              class="inline-flex min-h-11 max-w-[260px] items-center font-semibold text-ink sm:max-w-md"
            >
              <span class="truncate">{article.data.title}</span>
            </a>
          </li>
        </ol>
      </nav>

      <!-- Editorial Header: satu kolom, metadata ringkas -->
      <header class="space-y-5">
        <p class="font-mono text-xs font-bold uppercase tracking-wide text-accent-link">
          {category.label}
        </p>

        <h1 class="font-brand text-3xl leading-[1.12] tracking-tight text-ink sm:text-4xl lg:text-[2.75rem]">
          {article.data.title}
        </h1>

        <p class="max-w-[65ch] text-base leading-relaxed text-ink-secondary sm:text-lg">
          {article.data.description}
        </p>

        <p class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs tabular-nums text-ink-muted">
          <time datetime={article.data.pubDate.toISOString()}>{formattedDate}</time>
          <span aria-hidden="true">&middot;</span>
          <span>{readingTime} menit baca</span>
          {
            showsServiceScore && (
              <Fragment>
                <span aria-hidden="true">&middot;</span>
                <span>Skor servis {article.data.repairabilityScore}/10</span>
              </Fragment>
            )
          }
          <span aria-hidden="true">&middot;</span>
          <span>{article.data.author}</span>
        </p>
      </header>

      <!-- Ilustrasi artikel, tanpa header plate portal -->
      <figure class="mb-10 mt-10">
        <div class="overflow-hidden border border-line bg-plate">
          <Image
            src={article.data.image}
            alt={article.data.title}
            width={1080}
            height={810}
            loading="eager"
            fetchpriority="high"
            class="h-auto max-h-[580px] w-full object-contain"
          />
        </div>
        <figcaption class="mt-2 font-mono text-xs text-ink-muted">
          Ilustrasi BedahGadget.id
        </figcaption>
      </figure>

      <!-- Prosa artikel -->
      <div class="article-prose">
        <Content />
      </div>

      <!-- Callout mengalir setelah isi artikel, bukan di layar pertama -->
      {article.data.fixnowTopic && (
        <FixNowCallout topic={article.data.fixnowTopic} slug={article.slug} />
      )}

      <!-- Tanya jawab teknis -->
      {
        article.data.faqs && article.data.faqs.length > 0 && (
          <section aria-labelledby="faq-title" class="mt-12 border-t border-line pt-8">
            <h2 id="faq-title" class="font-brand text-2xl tracking-tight text-ink">
              Tanya jawab teknis
            </h2>
            <div class="mt-4 divide-y divide-line border-y border-line">
              {article.data.faqs.map((faq) => (
                <div class="space-y-2 py-5">
                  <h3 class="font-brand text-lg leading-snug text-ink">{faq.question}</h3>
                  <p class="text-sm leading-relaxed text-ink-secondary">{faq.answer}</p>
                </div>
              ))}
            </div>
          </section>
        )
      }

      <!-- Topik artikel -->
      {
        article.data.tags.length > 0 && (
          <div class="mt-10 flex flex-wrap items-center gap-2 border-t border-line pt-6 font-mono text-xs">
            <span class="mr-2 text-ink-muted">Topik:</span>
            {article.data.tags.map((tag) => (
              <a
                href={`/tag/${tag.toLowerCase().replace(/\s+/g, '-')}/`}
                class="inline-flex min-h-11 min-w-11 items-center justify-center border border-line bg-surface px-3 text-ink-secondary transition-colors hover:border-line-strong hover:text-accent-link"
              >
                #{tag}
              </a>
            ))}
          </div>
        )
      }
    </article>

    <!-- Artikel terkait di kolom yang sama, setelah isi artikel -->
    {
      related.length > 0 && (
        <div class="border-t border-line py-12 lg:py-16">
          <ArticleList
            articles={related}
            heading="Dokumentasi teknis terkait"
            headingId="artikel-terkait"
          />
          <a
            href={category.archivePath}
            class="mt-6 inline-flex min-h-11 items-center font-mono text-xs font-bold text-accent-link underline underline-offset-4"
          >
            Lihat semua {category.label}
          </a>
        </div>
      )
    }
  </div>
</BaseLayout>
