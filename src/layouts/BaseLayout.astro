---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'review' | 'about';
  publishDate?: Date;
  updatedDate?: Date;
  author?: string;
  canonicalUrl?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Publikasi jurnalisme teknis independen yang membedah anatomi motherboard, arsitektur silikon AI, dan mekanika laptop bersama workshop FixNow.id Bandung.',
  image = '/brand/png/lockup-horizontal-dark-1024.png',
  type = 'website',
  publishDate,
  updatedDate,
  author = 'Tim BedahGadget.id',
  canonicalUrl,
  noindex = false,
} = Astro.props;

const siteUrl = 'https://bedahgadget.id';
const resolvedCanonical = canonicalUrl || new URL(Astro.url.pathname, siteUrl).href;
const resolvedImage = image.startsWith('http') ? image : new URL(image, siteUrl).href;
const fullTitle = title.includes('BedahGadget') || title.includes('bedahgadget.id')
  ? title
  : `${title} | bedahgadget.id`;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Theme Initialization: respects user setting, falls back to system preference -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('bg-theme');
          if (saved === 'dark' || saved === 'light') {
            document.documentElement.setAttribute('data-theme', saved);
          } else {
            var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            document.documentElement.setAttribute('data-theme', prefersDark ? 'dark' : 'light');
          }
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>

    <!-- Theme Color for Browser Header -->
    <meta name="theme-color" content="#17120F" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#EFE9DF" media="(prefers-color-scheme: light)" />

    <!-- Favicon & Brand Icons -->
    <link rel="icon" type="image/svg+xml" href="/brand/svg/icon-dark.svg" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/brand/png/profile-navy.png" />

    <!-- Self-Hosted Archivo Black Font Preload -->
    <link
      rel="preload"
      href="/brand/fonts/ArchivoBlack-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Canonical URL & Search Engine Indexing -->
    {!noindex && <link rel="canonical" href={resolvedCanonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type === 'article' || type === 'review' ? 'article' : 'website'} />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedImage} />
    <meta property="og:site_name" content="bedahgadget.id" />
    <meta property="og:locale" content="id_ID" />
    {publishDate && <meta property="article:published_time" content={publishDate.toISOString()} />}
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
    {author && <meta property="article:author" content={author} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={resolvedCanonical} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedImage} />

    <!-- Alternate Feeds & Machine Metadata -->
    <link rel="alternate" type="application/rss+xml" title="bedahgadget.id RSS Feed" href="/rss.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs.txt" />

    <!-- Schema.org JSON-LD Slot -->
    <slot name="schema">
      {!noindex && type === 'website' && (
        <JsonLd
          type="website"
          title={fullTitle}
          description={description}
          url={resolvedCanonical}
          image={resolvedImage}
        />
      )}
    </slot>
  </head>
  <body class="min-h-screen flex flex-col bg-page text-ink">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:bg-action focus:text-on-action focus:inline-flex focus:min-h-11 focus:items-center focus:px-4 focus:py-2 focus:font-mono focus:text-xs"
    >
      Langsung ke isi utama
    </a>
    <Navbar />
    <main id="main-content" class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
