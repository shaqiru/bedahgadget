---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { articlePath, categories } from '../lib/categories';
import { designatorFor } from '../lib/archive';
import { readingTime } from '../lib/reading-time';

export interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { title, pubDate, category } = article.data;

const href = articlePath(category, article.slug);
const designator = designatorFor(article.slug);
const minutes = readingTime(article);
const spokenCategory = categories[category].label;
const formattedDate = pubDate.toLocaleDateString('id-ID', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article
  class="group relative flex items-center gap-4 border-b border-line px-4 py-4 last:border-b-0 hover:bg-elevated focus-within:bg-elevated motion-safe:transition-colors sm:px-5"
>
  <span class="w-[4.5rem] shrink-0 border border-line bg-plate">
    <Image
      src={article.data.image}
      alt=""
      width={96}
      height={72}
      loading="lazy"
      class="h-full w-full object-contain"
    />
  </span>

  <div class="min-w-0">
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-xs tabular-nums text-ink-muted">
      {designator ? <span class="part-tag">{designator}</span> : null}
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
      <span aria-hidden="true">&middot;</span>
      <span>{minutes} mnt</span>
      <span class="sr-only">, {spokenCategory}</span>
    </div>
    <h3
      class="mt-1 line-clamp-3 font-brand text-sm leading-snug tracking-tight text-ink transition-colors group-hover:text-accent-ember group-focus-within:text-accent-ember sm:text-base"
    >
      <a href={href} class="after:absolute after:inset-0 after:content-['']">
        {title}
      </a>
    </h3>
  </div>
</article>
