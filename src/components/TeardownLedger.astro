---
import type { CollectionEntry } from 'astro:content';

export interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const specs = article.data.specDetails ?? [];
const failures = article.data.failurePoints ?? [];

if (specs.length === 0 && failures.length === 0) return null;
---

<section class="panel overflow-hidden" aria-label="Lembar checklist teardown">
  <div class="panel-head">
    <h2 class="font-bold uppercase">Lembar checklist teardown</h2>
    <span class="text-ink-muted">{specs.length + failures.length} BUTIR</span>
  </div>

  {
    specs.length > 0 && (
      <dl class="divide-y divide-line border-t border-line">
        {specs.map((spec) => (
          <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1 px-4 py-3">
            <dt class="font-mono text-[11px] uppercase tracking-wide text-ink-muted">{spec.label}</dt>
            <dd class="font-mono text-xs font-semibold text-ink">{spec.value}</dd>
          </div>
        ))}
      </dl>
    )
  }

  {
    failures.length > 0 && (
      <div class="border-t border-line bg-elevated/50 p-4 sm:p-5">
        <h3 class="font-mono text-xs font-bold uppercase text-accent-danger">
          Titik rawan kegagalan fisik
        </h3>
        <ul class="mt-2 list-disc space-y-1.5 pl-4 text-xs leading-relaxed text-ink-secondary sm:text-sm">
          {failures.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </div>
    )
  }
</section>
