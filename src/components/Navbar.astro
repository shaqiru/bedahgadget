---
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.slice(1);

const navItems = [
  { name: 'Beranda', href: '/', active: currentPath === '' },
  { name: 'Bedah Anatomi', href: '/bedah/', active: currentPath.startsWith('bedah') },
  { name: 'AI & Silikon', href: '/ai/', active: currentPath.startsWith('ai') },
  { name: 'Review Laptop', href: '/review/', active: currentPath.startsWith('review') },
  { name: 'Tentang & Workshop', href: '/tentang/', active: currentPath.startsWith('tentang') },
];
---

<header class="sticky top-0 z-50 bg-surface/95 backdrop-blur-sm border-b border-line">
  <!-- Technical status strip: responsive with no mobile truncation -->
  <div class="border-b border-line bg-elevated/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-11 flex items-center justify-between text-[11px] font-mono tabular-nums text-ink-muted">
      <div class="flex items-center gap-2 sm:gap-4 truncate">
        <span class="hidden sm:inline font-semibold text-ink">PUBLIKASI TEKNIS PERANGKAT KERAS</span>
        <span class="sm:hidden font-semibold text-ink">BEDAHGADGET.ID</span>
        <span class="text-line">|</span>
        <span class="truncate">WORKSHOP FIXNOW.ID (JL. MANTERON NO. 12)</span>
      </div>
      <div class="flex items-center gap-2 shrink-0 ml-2">
        <button
          id="theme-toggle"
          type="button"
          aria-label="Ganti mode tampilan terang atau gelap"
          class="inline-flex min-h-11 min-w-11 items-center justify-center px-2 py-0.5 border border-line bg-surface text-ink hover:border-ocean transition-colors font-mono text-[11px]"
        >
          <span class="theme-light-only sm:hidden">TERANG</span>
          <span class="theme-light-only hidden sm:inline">MODE: KERTAS (#F4F4F4)</span>
          <span class="theme-dark-only sm:hidden">GELAP</span>
          <span class="theme-dark-only hidden sm:inline">MODE: GELAP (#0B132B)</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Main navigation bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Brand Logo -->
      <a href="/" class="flex min-h-11 items-center gap-2 shrink-0" aria-label="Beranda bedahgadget.id">
        <img
          src="/brand/svg/lockup-horizontal-light.svg"
          alt="bedahgadget.id"
          class="h-8 sm:h-9 w-auto hidden sm:block theme-light-only"
          width="210"
          height="36"
        />
        <img
          src="/brand/svg/lockup-horizontal-dark.svg"
          alt="bedahgadget.id"
          class="h-8 sm:h-9 w-auto hidden sm:block theme-dark-only"
          width="210"
          height="36"
        />
        <img
          src="/brand/svg/icon-light.svg"
          alt="bedahgadget.id"
          class="h-8 w-8 sm:hidden theme-light-only"
          width="32"
          height="32"
        />
        <img
          src="/brand/svg/icon-dark.svg"
          alt="bedahgadget.id"
          class="h-8 w-8 sm:hidden theme-dark-only"
          width="32"
          height="32"
        />
        <span class="font-brand text-base tracking-tight sm:hidden text-ink">
          BEDAH<span class="text-accent-link">GADGET</span><span class="text-ink-muted text-xs">.id</span>
        </span>
      </a>

      <!-- Desktop Navigation -->
      <nav aria-label="Navigasi utama" class="hidden md:flex items-center h-full">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              aria-current={item.active ? 'page' : undefined}
              class:list={[
                'h-16 inline-flex items-center px-4 text-sm font-medium border-b-2 transition-colors',
                item.active
                  ? 'border-ocean text-ink font-semibold'
                  : 'border-transparent text-ink-secondary hover:text-ink hover:border-line',
              ]}
            >
              {item.name}
            </a>
          ))
        }
      </nav>

      <!-- Direct Workshop Link -->
      <div class="hidden lg:flex items-center">
        <a
          href="https://fixnow.id/?utm_source=bedahgadget&utm_medium=navbar"
          target="_blank"
          rel="noopener"
          class="inline-flex min-h-11 items-center gap-2 px-3.5 py-2 text-xs font-mono font-semibold bg-action text-on-action hover:bg-action-hover hover:text-on-action-hover transition-colors border border-line-strong"
        >
          <span>MEJA SERVIS FIXNOW.ID</span>
        </a>
      </div>

      <!-- Mobile Menu Toggle -->
      <div class="flex md:hidden">
        <button
          id="mobile-menu-btn"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="inline-flex min-h-11 min-w-11 items-center justify-center p-2 text-ink border border-line bg-surface hover:border-ocean"
          aria-label="Buka menu navigasi"
        >
          <svg
            id="menu-icon-open"
            class="h-5 w-5"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-line bg-surface">
    <nav aria-label="Navigasi seluler" class="px-4 py-3 space-y-1">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={item.active ? 'page' : undefined}
            class:list={[
              'block px-3 py-2.5 text-sm font-medium border-l-2 transition-colors',
              item.active
                ? 'border-ocean bg-elevated text-ink font-semibold'
                : 'border-transparent text-ink-secondary hover:bg-elevated hover:text-ink',
            ]}
          >
            {item.name}
          </a>
        ))
      }
      <div class="pt-3 mt-2 border-t border-line">
        <a
          href="https://fixnow.id/?utm_source=bedahgadget&utm_medium=navbar_mobile"
          target="_blank"
          rel="noopener"
          class="inline-flex min-h-11 items-center justify-center w-full text-center px-4 py-2.5 text-xs font-mono font-semibold bg-action text-on-action hover:bg-action-hover hover:text-on-action-hover transition-colors"
        >
          MEJA SERVIS FIXNOW.ID BANDUNG
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const themeBtn = document.getElementById('theme-toggle');

  if (btn && menu) {
    btn.addEventListener('click', () => {
      const isHidden = menu.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', String(!isHidden));
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
        btn.focus();
      }
    });
  }

  if (themeBtn) {
    themeBtn.addEventListener('click', () => {
      const html = document.documentElement;
      const current = html.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
      const next = current === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-theme', next);
      try {
        localStorage.setItem('bg-theme', next);
      } catch (e) {}
    });
  }
</script>
