---
import Icon from './Icon.astro';

const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.slice(1);

const navItems = [
  { name: 'Beranda', href: '/', active: currentPath === '' },
  { name: 'Bedah Anatomi', href: '/bedah/', active: currentPath.startsWith('bedah') },
  { name: 'AI & Silikon', href: '/ai/', active: currentPath.startsWith('ai') },
  { name: 'Review Laptop', href: '/review/', active: currentPath.startsWith('review') },
  { name: 'Tentang & Workshop', href: '/tentang/', active: currentPath.startsWith('tentang') },
];
---

<header class="glass glass-edge sticky top-0 z-50 border-b border-line">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between gap-3 h-16">
      <!-- Brand Logo -->
      <a href="/" class="flex min-h-11 items-center gap-2 shrink-0" aria-label="Beranda bedahgadget.id">
        <img
          src="/brand/svg/lockup-horizontal-light.svg"
          alt=""
          class="h-8 sm:h-11 w-auto hidden sm:block theme-light-only"
          width="163"
          height="44"
        />
        <img
          src="/brand/svg/lockup-horizontal-dark.svg"
          alt=""
          class="h-8 sm:h-11 w-auto hidden sm:block theme-dark-only"
          width="163"
          height="44"
        />
        <img
          src="/brand/svg/icon-light.svg"
          alt=""
          class="h-8 w-8 sm:hidden theme-light-only"
          width="32"
          height="32"
        />
        <img
          src="/brand/svg/icon-dark.svg"
          alt=""
          class="h-8 w-8 sm:hidden theme-dark-only"
          width="32"
          height="32"
        />
        <span class="font-brand text-base tracking-tight sm:hidden text-ink">
          BEDAHGADGET<span class="text-ink-muted text-xs">.id</span>
        </span>
      </a>

      <!-- Desktop Navigation -->
      <nav aria-label="Navigasi utama" class="hidden md:flex items-center h-full">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              aria-current={item.active ? 'page' : undefined}
              class:list={[
                'h-16 inline-flex items-center px-3 lg:px-4 text-sm border-b-2 transition-colors',
                item.active
                  ? 'border-accent-hot text-ink font-semibold'
                  : 'border-transparent text-ink-secondary hover:text-ink hover:border-line-strong',
              ]}
            >
              {item.name}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-2 shrink-0">
        {/* Toggle tema: posisi thumb mengikuti html[data-theme], jadi tidak berkedip saat dimuat. */}
        <button
          id="theme-toggle"
          type="button"
          role="switch"
          aria-checked="false"
          aria-label="Mode gelap"
          class="group inline-flex min-h-11 min-w-11 items-center justify-center px-1"
        >
          <span class="relative inline-flex h-7 w-[3.25rem] items-center rounded-full border border-line-strong bg-elevated transition-colors group-hover:bg-surface">
            <span class="absolute left-[3px] inline-flex h-[1.375rem] w-[1.375rem] items-center justify-center rounded-full bg-ink text-page transition-transform duration-200 ease-out dark:translate-x-6">
              <span class="theme-light-only inline-flex"><Icon name="sun" weight="bold" class="h-3.5 w-3.5" /></span>
              <span class="theme-dark-only inline-flex"><Icon name="moon" weight="bold" class="h-3.5 w-3.5" /></span>
            </span>
          </span>
        </button>

        <a
          href="https://fixnow.id/?utm_source=bedahgadget&utm_medium=navbar"
          target="_blank"
          rel="noopener"
          class="btn btn-secondary hidden lg:inline-flex text-xs"
        >
          Meja servis FixNow.id
        </a>

        <!-- Mobile Menu Toggle -->
        <button
          id="mobile-menu-btn"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="md:hidden inline-flex min-h-11 min-w-11 items-center justify-center p-2 text-ink border border-line-strong hover:bg-elevated"
          aria-label="Buka menu navigasi"
        >
          <Icon name="list" weight="bold" class="h-5 w-5" />
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-line bg-surface">
    <nav aria-label="Navigasi seluler" class="px-4 py-3 space-y-1">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={item.active ? 'page' : undefined}
            class:list={[
              'flex min-h-11 items-center px-3 text-sm font-medium border-l-2 transition-colors',
              item.active
                ? 'border-accent-hot bg-elevated text-ink font-semibold'
                : 'border-transparent text-ink-secondary hover:bg-elevated hover:text-ink',
            ]}
          >
            {item.name}
          </a>
        ))
      }
      <div class="pt-3 mt-2 border-t border-line">
        <a
          href="https://fixnow.id/?utm_source=bedahgadget&utm_medium=navbar_mobile"
          target="_blank"
          rel="noopener"
          class="btn btn-primary w-full"
        >
          Meja servis FixNow.id Bandung
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const themeBtn = document.getElementById('theme-toggle');

  if (btn && menu) {
    btn.addEventListener('click', () => {
      const isHidden = menu.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', String(!isHidden));
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
        btn.focus();
      }
    });
  }

  if (themeBtn) {
    const html = document.documentElement;
    const sync = () => themeBtn.setAttribute('aria-checked', String(html.getAttribute('data-theme') === 'dark'));
    sync();
    themeBtn.addEventListener('click', () => {
      const current = html.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
      const next = current === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-theme', next);
      sync();
      try {
        // Pilihan sama dengan tema sistem: hapus preferensi supaya situs kembali mengikuti sistem.
        const system = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        if (next === system) localStorage.removeItem('bg-theme');
        else localStorage.setItem('bg-theme', next);
      } catch (e) {}
    });
  }
</script>
