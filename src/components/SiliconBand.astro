---
import type { CollectionEntry } from 'astro:content';

export interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const specs = article.data.specDetails ?? [];

if (specs.length === 0) return null;
---

<section class="panel overflow-hidden" aria-label="Parameter silikon artikel utama">
  <div class="panel-head">
    <h2 class="font-bold uppercase">Pita parameter silikon</h2>
    <span class="text-ink-muted">{specs.length} PARAMETER</span>
  </div>

  <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
    {
      specs.map((spec) => (
        <div class="border-b border-line p-4 sm:border-r">
          <dt class="font-mono text-[11px] uppercase tracking-wide text-ink-muted">{spec.label}</dt>
          <dd class="mt-1 font-mono text-sm font-semibold text-ink">{spec.value}</dd>
        </div>
      ))
    }
  </dl>

  <p class="px-4 py-3 font-mono text-xs text-ink-muted">
    Angka diambil dari lembar spesifikasi artikel, bukan hasil pengujian unit.
  </p>
</section>
