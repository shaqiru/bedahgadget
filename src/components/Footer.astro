    <div class="mt-10 pt-6 border-t border-line flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs font-mono text-ink-muted tabular-nums">
      <p>&copy; {currentYear} bedahgadget.id. Hak cipta dilindungi undang-undang.</p>
      <p>Standar publikasi: Tanpa iklan sponsor tersembunyi, berbasis pengamatan teknis objektif.</p>
    </div>
  </div>

  {/* Dinding glyph (src/pages/brand/glyph-wall.svg.ts): diambil saat footer mendekati viewport lalu
       disisipkan inline supaya warna mengikuti tema. Selebar layar penuh dan lebih besar dari
       viewport, sehingga terpotong di kiri, kanan, dan bawah. Tinggi dipesan dalam vw, jadi CLS tetap 0. */}
  <div class="relative mt-4 h-[50vw] overflow-hidden sm:h-[26vw]" aria-hidden="true">
    <div
      class="glyph-wall absolute left-1/2 top-0 aspect-[4/1] w-[250vw] -translate-x-1/2 sm:w-[133vw]"
      data-glyph-wall
      data-src="/brand/glyph-wall.svg"
    ></div>
  </div>
</footer>

<script>
  const wall = document.querySelector<HTMLElement>('[data-glyph-wall]');
  if (wall?.dataset.src) {
    const src = wall.dataset.src;
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        observer.disconnect();
        fetch(src)
          .then((response) => (response.ok ? response.text() : Promise.reject()))
          // Aset dari build situs sendiri (same-origin), bukan masukan pengguna.
          .then((svg) => wall.insertAdjacentHTML('afterbegin', svg))
          .catch(() => {
            // Gagal dimuat: ruang tetap kosong dengan ukuran yang sudah dipesan.
          });
      },
      { rootMargin: '400px 0px' },
    );
    observer.observe(wall);
  }
</script>
