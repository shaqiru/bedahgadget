---
import type { DesignatorEntry } from '../lib/archive';

export interface Props {
  /** Designator milik artikel rubrik ini, hasil designatorsFor. */
  designators: DesignatorEntry[];
  /** "wide" menaruh istilah berjajar saat panel memakai lebar penuh. */
  variant?: 'rail' | 'wide';
}

const { designators, variant = 'rail' } = Astro.props;
const hasDesignators = designators.length > 0;
const termCount = (hasDesignators ? 1 : 0) + 2;
const isWide = variant === 'wide';
---

<div class="panel overflow-hidden">
  <div class="panel-head">
    <h2 class="font-bold uppercase">Cara membaca plate</h2>
    <span class="text-ink-muted">{termCount} ISTILAH</span>
  </div>
  <dl
    class:list={[
      'divide-y divide-line',
      isWide ? 'lg:grid lg:grid-cols-3 lg:divide-x lg:divide-y-0' : '',
    ]}
  >
    {
      hasDesignators && (
        <div class="p-5">
          <dt class="font-mono text-xs font-bold uppercase tracking-wide text-ink">Designator</dt>
          <dd class="mt-1.5 text-sm leading-relaxed text-ink-secondary">
            Kode di kepala plate mengikuti penamaan komponen PCB untuk rubrik ini.
            <ul class="mt-2 space-y-1">
              {designators.map((entry) => (
                <li class="flex items-baseline gap-2">
                  <span class="part-tag">{entry.designator}</span>
                  <span>{entry.name}</span>
                </li>
              ))}
            </ul>
          </dd>
        </div>
      )
    }
    <div class="p-5">
      <dt class="font-mono text-xs font-bold uppercase tracking-wide text-ink">Skor servis</dt>
      <dd class="mt-1.5 text-sm leading-relaxed text-ink-secondary">
        Angka 1&ndash;10 adalah perkiraan tingkat kesulitan servis untuk kasus yang dibahas,
        bukan jaminan hasil perbaikan atau patokan biaya.
      </dd>
    </div>
    <div class="p-5">
      <dt class="font-mono text-xs font-bold uppercase tracking-wide text-ink">Still teknis</dt>
      <dd class="mt-1.5 text-sm leading-relaxed text-ink-secondary">
        Semua gambar adalah ilustrasi anatomi dan rekonstruksi, bukan foto unit uji atau hasil
        mikroskop.
      </dd>
    </div>
  </dl>
</div>
