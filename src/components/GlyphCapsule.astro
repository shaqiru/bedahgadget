---
// Kapsul vertikal: tile glyph bertumpuk di dalam bentuk pil (ujung membulat dipotong clipPath).
import { tileMarkup } from '../lib/glyphs';
import type { GlyphName, TileKind } from '../lib/glyphs';

export interface Props {
  id: string; // wajib unik per halaman (id clipPath)
  glyphs: [GlyphName, TileKind][];
  class?: string;
}

const { id, glyphs, class: className = 'w-14' } = Astro.props;
const size = 64;
const height = glyphs.length * size;
const radius = size * 0.5;
const tiles = (await Promise.all(glyphs.map(([name, kind], i) => tileMarkup(name, kind, 0, i * size, size)))).join('');
const svg =
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${size} ${height}" class="block h-auto ${className}" aria-hidden="true" focusable="false">` +
  `<defs><clipPath id="${id}"><rect width="${size}" height="${height}" rx="${radius}"/></clipPath></defs>` +
  `<g clip-path="url(#${id})">${tiles}</g></svg>`;
---

<Fragment set:html={svg} />
