---
import Glyph from './Glyph.astro';
import Icon from './Icon.astro';
import { fixnowTopicMap } from '../lib/fixnow-topics';
import type { FixnowTopic } from '../content/config';
import type { GlyphName } from '../lib/glyphs';

export interface Props {
  label: string;
  href: string;
  title: string;
  topic: FixnowTopic;
  slug: string;
  designator?: string;
  minutes: number;
  /** Glyph flat yang mewakili kerusakan gejala ini. */
  glyph: GlyphName;
  /** Jenis bidang warna di belakang glyph. */
  tone: 'heat' | 'accent' | 'ink' | 'plate';
  /** Baris genap: bidang glyph pindah ke kanan di desktop. Urutan DOM tidak berubah. */
  flipped?: boolean;
}

const { label, href, title, topic, slug, designator, minutes, glyph, tone, flipped = false } = Astro.props;
const service = fixnowTopicMap[topic];
const serviceUrl = `${service.url}?utm_source=bedahgadget&utm_medium=home_symptom&utm_content=${encodeURIComponent(slug)}`;
---

<article class="panel card-active group relative symptom-row">
  <div class="flex flex-col lg:grid lg:grid-cols-12 lg:items-stretch">
    <!-- Copy selalu lebih dulu di DOM. Sisi glyph yang berganti, bukan urutan baca. -->
    <div class="flex flex-col gap-4 p-5 sm:p-6 lg:col-span-7 lg:gap-4 lg:p-8">
      <p class="flex flex-wrap items-center gap-2 font-mono text-xs tabular-nums">
        {designator ? <span class="part-tag">{designator}</span> : null}
        <span class="text-ink-muted">{minutes} mnt baca</span>
      </p>

      <h3 class="font-brand text-2xl leading-tight tracking-tight text-ink transition-colors group-hover:text-accent-ember group-focus-within:text-accent-ember sm:text-3xl">
        {label}
      </h3>

      <a href={href} class="flex max-w-[46ch] flex-col gap-2 after:absolute after:inset-0 after:content-['']">
        <span class="text-sm leading-relaxed text-ink-secondary transition-colors group-hover:text-accent-ember group-focus-within:text-accent-ember sm:text-base">
          {title}
        </span>
        <span
          aria-hidden="true"
          class="inline-flex items-center gap-1.5 font-mono text-xs font-bold uppercase tracking-wide text-accent-link underline decoration-1 underline-offset-4 transition-colors group-hover:text-accent-ember group-focus-within:text-accent-ember group-hover:decoration-2 group-focus-within:decoration-2"
        >
          Baca bedahnya
          <Icon name="arrow-right" weight="bold" class="h-3.5 w-3.5" />
        </span>
      </a>

      <div class="mt-auto border-t border-line pt-4">
        <a
          href={serviceUrl}
          target="_blank"
          rel="noopener"
          class="relative z-10 inline-flex min-h-11 items-center gap-1.5 font-mono text-xs font-bold uppercase tracking-wide text-accent-link underline decoration-1 underline-offset-4 transition-colors hover:text-accent-ember hover:decoration-2"
        >
          Cek gratis di FixNow.id
          <span aria-hidden="true">&nearr;</span>
          <span class="sr-only"> (buka di tab baru)</span>
        </a>
      </div>
    </div>

    <!-- Bidang warna dan glyph dekoratif. Tidak diumumkan, tidak fokusable. -->
    <div
      class:list={[
        'g-tile-fill g-tile-' + tone,
        'order-first flex h-[248px] items-center justify-center p-4 transition-[filter] duration-150 group-hover:brightness-[0.94] group-focus-within:brightness-[0.94] sm:p-5 lg:col-span-5 lg:h-auto lg:min-h-[336px]',
        // Ponsel: glyph selalu di atas copy. Desktop: baris ganjil di kiri, baris genap di kanan.
        flipped ? 'lg:order-none' : 'lg:order-first',
      ]}
      aria-hidden="true"
    >
      <Glyph name={glyph} class="h-36 w-36 sm:h-40 sm:w-40 lg:h-44 lg:w-44" />
    </div>
  </div>
</article>

<style>
  /* Bidang warna menutup cincin inset dari .card-active, jadi hover memakai lapisan
     tipis di atas isi kartu. Tidak menangkap klik supaya stretched link tetap berfungsi. */
  .symptom-row::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 5;
    border: 2px solid transparent;
    pointer-events: none;
    transition: border-color 150ms ease;
  }

  .symptom-row:hover::before,
  .symptom-row:focus-within::before {
    border-color: var(--accent-hot);
  }
</style>
