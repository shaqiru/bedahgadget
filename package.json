{
  "name": "website-bedahgadget",
  "version": "1.0.0",
  "description": "Portal media bedah anatomi hardware gadget, ulasan AI & review laptop terafiliasi dengan FixNow.id",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build && node scripts/check-theme-css.mjs",
    "check": "astro check",
    "check:css": "node scripts/check-theme-css.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check:content": "node scripts/check-content-security.mjs",
    "check:dist": "node scripts/validate-dist.mjs",
    "check:publication": "node scripts/check-publication.mjs",
    "lint:style": "node scripts/lint-style.mjs",
    "verify": "npm run check:publication && npm run check:content && npm run build && npm run check:dist && npm run lint:style"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^7.4.7",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@mdx-js/mdx": "3.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "typescript": "^5.9.3"
  }
}
